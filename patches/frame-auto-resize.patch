+/**
+ * Infers the initial auto-layout direction from the current arrangement of
+ * direct children (groups count as one item). Left-to-right → horizontal,
+ * top-to-bottom → vertical. Ties and empty/single-item frames default to vertical.
+ */
+export const inferFrameAutoLayoutDirection = (
+  frame: ExcalidrawFrameLikeElement,
+  allElements: ElementsMapOrArray,
+): "vertical" | "horizontal" => {
+  const items = getFrameAutoLayoutItems(frame, allElements);
+  if (items.length < 2) {
+    return "vertical";
+  }
+
+  let minCx = Infinity;
+  let maxCx = -Infinity;
+  let minCy = Infinity;
+  let maxCy = -Infinity;
+  for (const item of items) {
+    const cx = (item.x1 + item.x2) / 2;
+    const cy = (item.y1 + item.y2) / 2;
+    minCx = Math.min(minCx, cx);
+    maxCx = Math.max(maxCx, cx);
+    minCy = Math.min(minCy, cy);
+    maxCy = Math.max(maxCy, cy);
+  }
+
+  const spreadX = maxCx - minCx;
+  const spreadY = maxCy - minCy;
+  return spreadX > spreadY ? "horizontal" : "vertical";
+};
+
+export const getAutoLayoutInsertIndex = (
+  items: readonly FrameAutoLayoutItem[],
+  pointer: { x: number; y: number },
+  direction: "vertical" | "horizontal",
+) => {
+  for (let index = 0; index < items.length; index++) {
+    const item = items[index];
+    const midpoint =
+      direction === "vertical"
+        ? (item.y1 + item.y2) / 2
+        : (item.x1 + item.x2) / 2;
+    const pointerAlongAxis = direction === "vertical" ? pointer.y : pointer.x;
+    if (pointerAlongAxis < midpoint) {
+      return index;
+    }
+  }
+  return items.length;
+};
+
+export const getAutoLayoutDropIndicator = (
+  frame: ExcalidrawFrameLikeElement,
+  allElements: ElementsMapOrArray,
+  pointer: { x: number; y: number },
+  opts?: {
+    editingGroupId?: string | null;
+    excludeIds?: ReadonlySet<string>;
+  },
+): AutoLayoutDropIndicator | null => {
+  if (!frame.autoLayout || frame.collapsed) {
+    return null;
+  }
+
+  const direction = frame.autoLayout;
+  const items = getFrameAutoLayoutItems(frame, allElements, opts);
+  const index = getAutoLayoutInsertIndex(items, pointer, direction);
+  const gap = frame.autoLayoutGap ?? DEFAULT_FRAME_AUTO_LAYOUT_GAP;
+  const fallback = 48;
+
+  if (!items.length) {
+    const padding = {
+      horizontal:
+        frame.autoLayoutPadding?.horizontal ??
+        DEFAULT_FRAME_AUTO_LAYOUT_PADDING,
+      vertical:
+        frame.autoLayoutPadding?.vertical ?? DEFAULT_FRAME_CONTENT_PADDING_Y,
+    };
+    const titleHeight = getFrameTitleReservedHeight(frame);
+    if (direction === "vertical") {
+      const y = frame.y + titleHeight + padding.vertical;
+      const x1 = frame.x + padding.horizontal;
+      return { x1, y1: y, x2: x1 + fallback, y2: y };
+    }
+    const x = frame.x + padding.horizontal;
+    const y1 = frame.y + titleHeight + padding.vertical;
+    return { x1: x, y1, x2: x, y2: y1 + fallback };
+  }
+
+  const prev = index > 0 ? items[index - 1] : null;
+  const next = index < items.length ? items[index] : null;
+  const neighbors = [prev, next].filter(
+    (item): item is FrameAutoLayoutItem => item != null,
+  );
+
+  if (direction === "vertical") {
+    const y = next
+      ? prev
+        ? (prev.y2 + next.y1) / 2
+        : next.y1 - gap / 2
+      : prev!.y2 + gap / 2;
+    return {
+      x1: Math.min(...neighbors.map((item) => item.x1)),
+      y1: y,
+      x2: Math.max(...neighbors.map((item) => item.x2)),
+      y2: y,
+    };
+  }
+
+  const x = next
+    ? prev
+      ? (prev.x2 + next.x1) / 2
+      : next.x1 - gap / 2
+    : prev!.x2 + gap / 2;
+  return {
+    x1: x,
+    y1: Math.min(...neighbors.map((item) => item.y1)),
+    x2: x,
+    y2: Math.max(...neighbors.map((item) => item.y2)),
+  };
+};
+
+const applyLayoutItemDelta = (
+  item: FrameAutoLayoutItem,
+  deltaX: number,
+  deltaY: number,
+  elementsMap: ElementsMap,
+) => {
+  if (!deltaX && !deltaY) {
+    return;
+  }
+  const moved = new Set(item.elements);
+  for (const element of item.elements) {
+    mutateElement(element, elementsMap, {
+      x: element.x + deltaX,
+      y: element.y + deltaY,
+    });
+    const boundTextElement = getBoundTextElement(element, elementsMap);
+    if (boundTextElement && !moved.has(boundTextElement)) {
+      mutateElement(boundTextElement, elementsMap, {
+        x: boundTextElement.x + deltaX,
+        y: boundTextElement.y + deltaY,
+      });
+      moved.add(boundTextElement);
+    }
+  }
+};
