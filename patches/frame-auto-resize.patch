+    const childWidth = x2 - x1;
+    const childHeight = y2 - y1;
+
+    if (direction === "vertical") {
+      cursorY += childHeight + gap;
+      contentHeight += childHeight + (contentHeight ? gap : 0);
+      contentWidth = Math.max(contentWidth, childWidth);
+    } else {
+      cursorX += childWidth + gap;
+      contentWidth += childWidth + (contentWidth ? gap : 0);
+      contentHeight = Math.max(contentHeight, childHeight);
+    }
+  }
