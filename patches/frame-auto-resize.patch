+/**
+ * Returns all ancestor frames of an element, from innermost (direct parent) to outermost.
+ * Used for nested frame clipping - elements should be clipped by all ancestor frames.
+ */
+export const getAncestorFrames = (
+  element: ExcalidrawElement,
+  elementsMap: ElementsMap,
+): ExcalidrawFrameLikeElement[] => {
+  const ancestors: ExcalidrawFrameLikeElement[] = [];
+  let current: ExcalidrawElement | null = element;
+
+  while (current?.frameId) {
+    const parent = elementsMap.get(current.frameId);
+    if (parent && isFrameLikeElement(parent)) {
+      ancestors.push(parent);
+      current = parent;
+    } else {
+      break;
+    }
+  }
+
+  return ancestors;
+};
