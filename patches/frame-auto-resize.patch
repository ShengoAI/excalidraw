+export const collectFrameDescendants = (
+  selectedElements: readonly NonDeletedExcalidrawElement[],
+  allElements: readonly NonDeletedExcalidrawElement[],
+): NonDeletedExcalidrawElement[] => {
+  const frames = new Set(
+    selectedElements.filter((e) => isFrameLikeElement(e)).map((f) => f.id),
+  );
+  if (frames.size === 0) {
+    return [];
+  }
+
+  const descendants: NonDeletedExcalidrawElement[] = [];
+  const seen = new Set<string>();
+  let foundNewFrames = true;
+  while (foundNewFrames) {
+    foundNewFrames = false;
+    for (const element of allElements) {
+      if (
+        element.frameId !== null &&
+        frames.has(element.frameId) &&
+        !seen.has(element.id)
+      ) {
+        seen.add(element.id);
+        descendants.push(element);
+        if (isFrameLikeElement(element) && !frames.has(element.id)) {
+          frames.add(element.id);
+          foundNewFrames = true;
+        }
+      }
+    }
+  }
+  return descendants;
+};
