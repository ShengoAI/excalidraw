+export const positionAutoLayoutDrop = (
+  frame: ExcalidrawFrameLikeElement,
+  droppedElements: readonly ExcalidrawElement[],
+  pointer: { x: number; y: number },
+  allElements: ElementsMapOrArray,
+  editingGroupId: string | null = null,
+) => {
+  if (!frame.autoLayout || frame.collapsed) {
+    return;
+  }
+
+  const elementsMap = arrayToMap(allElements);
+  const members = droppedElements.filter(
+    (element) => element.frameId === frame.id && isAutoLayoutMember(element),
+  );
+  if (!members.length) {
+    return;
+  }
+
+  const excludeIds = new Set(members.map((element) => element.id));
+  const remaining = getFrameAutoLayoutItems(frame, allElements, {
+    editingGroupId,
+    excludeIds,
+  });
+  const droppedItems = sortAutoLayoutItems(
+    collectAutoLayoutItems(members, elementsMap, { editingGroupId }),
+    frame.autoLayout,
+  );
+  const insertIndex = getAutoLayoutInsertIndex(
+    remaining,
+    pointer,
+    frame.autoLayout,
+  );
+
+  for (let offset = 0; offset < droppedItems.length; offset++) {
+    const item = droppedItems[offset];
+    const index = insertIndex + offset;
+    const itemSize =
+      frame.autoLayout === "vertical" ? item.y2 - item.y1 : item.x2 - item.x1;
+    let targetStart: number;
+    if (!remaining.length) {
+      continue;
+    }
+    if (index <= 0) {
+      const first = remaining[0];
+      const firstStart = frame.autoLayout === "vertical" ? first.y1 : first.x1;
+      targetStart = firstStart - itemSize - 1 - (droppedItems.length - 1 - offset);
+    } else if (index >= remaining.length) {
+      const last = remaining[remaining.length - 1];
+      const lastEnd = frame.autoLayout === "vertical" ? last.y2 : last.x2;
+      targetStart = lastEnd + 1 + offset;
+    } else {
+      const next = remaining[index];
+      const nextStart = frame.autoLayout === "vertical" ? next.y1 : next.x1;
+      targetStart = nextStart - itemSize - (droppedItems.length - offset);
+    }
+    const currentStart = frame.autoLayout === "vertical" ? item.y1 : item.x1;
+    const delta = targetStart - currentStart;
+    applyLayoutItemDelta(
+      item,
+      frame.autoLayout === "horizontal" ? delta : 0,
+      frame.autoLayout === "vertical" ? delta : 0,
+      elementsMap,
+    );
+  }
+};
