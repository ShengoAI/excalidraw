+export const getFrameAutoLayoutItems = (
+  frame: ExcalidrawFrameLikeElement,
+  allElements: ElementsMapOrArray,
+  opts?: {
+    editingGroupId?: string | null;
+    excludeIds?: ReadonlySet<string>;
+  },
+) => {
+  const elementsMap = arrayToMap(allElements);
+  const elements = Array.isArray(allElements)
+    ? allElements
+    : Array.from(allElements.values());
+  const items = collectAutoLayoutItems(
+    getFrameChildren(getNonDeletedElements(elements), frame.id),
+    elementsMap,
+    opts,
+  );
+  if (frame.autoLayout) {
+    sortAutoLayoutItems(items, frame.autoLayout);
+  }
+  return items;
+};
