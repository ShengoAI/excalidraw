+  if (!direction || frame.collapsed) {
+    return false;
+  }
+
+  const padding = {
+    horizontal:
+      opts.padding?.horizontal ??
+      frame.autoLayoutPadding?.horizontal ??
+      DEFAULT_FRAME_AUTO_LAYOUT_PADDING,
+    vertical:
+      opts.padding?.vertical ??
+      frame.autoLayoutPadding?.vertical ??
+      DEFAULT_FRAME_CONTENT_PADDING_Y,
+  };
+  const gap =
+    opts.gap ?? frame.autoLayoutGap ?? DEFAULT_FRAME_AUTO_LAYOUT_GAP;
+  const hug = opts.hug ?? getFrameAutoLayoutHug(frame);
+  const align = opts.align ?? getFrameAutoLayoutAlign(frame);
+  const axes = ALIGN_AXES[align] ?? ALIGN_AXES["top-left"];
+
+  const elementsMap = arrayToMap(allElements);
+  const items = getFrameAutoLayoutItems(frame, allElements, {
+    editingGroupId: opts.editingGroupId,
+  });
+
+  if (!items.length) {
+    return false;
+  }
+
+  const itemMetrics = items.map((item) => ({
+    item,
+    width: item.x2 - item.x1,
+    height: item.y2 - item.y1,
+  }));
+
+  let contentWidth = 0;
+  let contentHeight = 0;
+  for (const metric of itemMetrics) {
+    if (direction === "vertical") {
+      contentHeight += metric.height + (contentHeight ? gap : 0);
+      contentWidth = Math.max(contentWidth, metric.width);
+    } else {
+      contentWidth += metric.width + (contentWidth ? gap : 0);
+      contentHeight = Math.max(contentHeight, metric.height);
+    }
+  }
+
+  const titleHeight = getFrameTitleReservedHeight(frame);
+  const bottomReserve = padding.vertical;
+  const contentFrameWidth = contentWidth + padding.horizontal * 2;
+  const contentFrameHeight =
+    contentHeight + titleHeight + padding.vertical + bottomReserve;
+
+  const nextWidth = hug.horizontal
+    ? contentFrameWidth
+    : opts.width ?? frame.width;
+  const nextHeight = hug.vertical
+    ? contentFrameHeight
+    : opts.height ?? frame.height;
+
+  const innerWidth = Math.max(0, nextWidth - padding.horizontal * 2);
+  const innerHeight = Math.max(
+    0,
+    nextHeight - titleHeight - padding.vertical - bottomReserve,
+  );
+  const extraW = innerWidth - contentWidth;
+  const extraH = innerHeight - contentHeight;
+
+  let cursorX = frame.x + padding.horizontal;
+  let cursorY = frame.y + titleHeight + padding.vertical;
+  if (direction === "vertical") {
+    cursorY += alignmentOffset(axes.vertical, extraH);
+  } else {
+    cursorX += alignmentOffset(axes.horizontal, extraW);
+  }
+
+  for (const metric of itemMetrics) {
+    const targetX1 =
+      direction === "vertical"
+        ? frame.x +
+          padding.horizontal +
+          alignmentOffset(axes.horizontal, innerWidth - metric.width)
+        : cursorX;
+    const targetY1 =
+      direction === "horizontal"
+        ? frame.y +
+          titleHeight +
+          padding.vertical +
+          alignmentOffset(axes.vertical, innerHeight - metric.height)
+        : cursorY;
+    applyLayoutItemDelta(
+      metric.item,
+      targetX1 - metric.item.x1,
+      targetY1 - metric.item.y1,
+      elementsMap,
