+  opts: {
+    width?: number;
+    height?: number;
+    padding?: Partial<{ horizontal: number; vertical: number }>;
+    gap?: number;
+  } = {},
+): boolean => {
+  if (!direction) {
+    return false;
+  }
+
+  const padding = {
+    horizontal:
+      opts.padding?.horizontal ??
+      frame.autoLayoutPadding?.horizontal ??
+      DEFAULT_FRAME_AUTO_LAYOUT_PADDING,
+    vertical:
+      opts.padding?.vertical ??
+      frame.autoLayoutPadding?.vertical ??
+      DEFAULT_FRAME_CONTENT_PADDING_Y,
+  };
+  const gap =
+    opts.gap ?? frame.autoLayoutGap ?? DEFAULT_FRAME_AUTO_LAYOUT_GAP;
+
+  const elementsMap = arrayToMap(allElements);
+  const elements = Array.isArray(allElements)
+    ? allElements
+    : Array.from(allElements.values());
+  const children = getFrameChildren(getNonDeletedElements(elements), frame.id)
+    .filter((element) => !(isTextElement(element) && element.containerId))
+    .sort((a, b) => {
+      if (direction === "vertical") {
+        return a.y === b.y ? a.x - b.x : a.y - b.y;
+      }
+      return a.x === b.x ? a.y - b.y : a.x - b.x;
+    });
+
+  if (!children.length) {
+    return false;
+  }
+
+  let cursorX = frame.x + padding.horizontal;
+  const titleHeight = getFrameTitleReservedHeight(frame);
+  // Add title height offset so children start below the frame title
+  let cursorY = frame.y + titleHeight + padding.vertical;
+  let contentWidth = 0;
+  let contentHeight = 0;
+
+  for (const child of children) {
+    const [x1, y1, x2, y2] = getElementAbsoluteCoords(child, elementsMap);
+    const deltaX = cursorX - x1;
+    const deltaY = cursorY - y1;
+
+    mutateElement(child, elementsMap, {
+      x: child.x + deltaX,
+      y: child.y + deltaY,
+    });
+
+    const boundTextElement = getBoundTextElement(child, elementsMap);
+    if (boundTextElement) {
+      mutateElement(boundTextElement, elementsMap, {
+        x: boundTextElement.x + deltaX,
+        y: boundTextElement.y + deltaY,
+      });
+    }
