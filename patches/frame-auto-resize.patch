+export const actionAutoResizeFrame = register({
+  name: "autoResizeFrame",
+  label: "labels.autoResizeFrame",
+  trackEvent: { category: "element" },
+  predicate: (elements, appState, _, app) => {
+    if (!isSingleFrameSelected(appState, app)) {
+      return false;
+    }
+    const selectedElement =
+      app.scene.getSelectedElements(appState).at(0) || null;
+    if (!isFrameLikeElement(selectedElement)) {
+      return false;
+    }
+    const childElements = getFrameChildren(
+      getNonDeletedElements(elements),
+      selectedElement.id,
+    );
+    return childElements.length > 0;
+  },
+  perform: (elements, appState, _, app) => {
+    const selectedElement =
+      app.scene.getSelectedElements(appState).at(0) || null;
+
+    if (!isFrameLikeElement(selectedElement)) {
+      return {
+        elements,
+        appState,
+        captureUpdate: CaptureUpdateAction.EVENTUALLY,
+      };
+    }
+
+    const elementsMap = app.scene.getNonDeletedElementsMap();
+    const childElements = getFrameChildren(
+      getNonDeletedElements(elements),
+      selectedElement.id,
+    );
+
+    if (childElements.length === 0) {
+      return {
+        elements,
+        appState,
+        captureUpdate: CaptureUpdateAction.EVENTUALLY,
+      };
+    }
+
+    const [x1, y1, x2, y2] = getCommonBounds(childElements, elementsMap);
+    const PADDING = 16;
+
+    mutateElement(selectedElement, elementsMap, {
+      x: x1 - PADDING,
+      y: y1 - PADDING,
+      width: x2 - x1 + PADDING * 2,
+      height: y2 - y1 + PADDING * 2,
+    });
+
+    return {
+      elements,
+      appState: {
+        ...appState,
+        selectedElementIds: {
+          [selectedElement.id]: true,
+        },
+      },
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
+
+export const actionToggleFrameClip = register({
+  name: "toggleFrameClip",
+  label: (elements, appState, app) => {
+    const selectedElement =
+      app.scene.getSelectedElements(appState).at(0) || null;
+    if (isFrameLikeElement(selectedElement) && selectedElement.clip === false) {
+      return "labels.clipFrameContent";
+    }
+    return "labels.unclipFrameContent";
+  },
+  trackEvent: { category: "element" },
+  predicate: (elements, appState, _, app) =>
+    isSingleFrameSelected(appState, app),
+  perform: (elements, appState, _, app) => {
+    const selectedElement =
+      app.scene.getSelectedElements(appState).at(0) || null;
+
+    if (!isFrameLikeElement(selectedElement)) {
+      return {
+        elements,
+        appState,
+        captureUpdate: CaptureUpdateAction.EVENTUALLY,
+      };
+    }
+
+    const elementsMap = app.scene.getNonDeletedElementsMap();
+    mutateElement(selectedElement, elementsMap, {
+      clip: !selectedElement.clip,
+    });
+
+    return {
+      elements,
+      appState: {
+        ...appState,
+        selectedElementIds: {
+          [selectedElement.id]: true,
+        },
+      },
+      captureUpdate: CaptureUpdateAction.IMMEDIATELY,
+    };
+  },
+});
