+/**
+ * Returns all ancestor frames of an element, from innermost (direct parent) to outermost.
+ * Used for nested frame clipping - elements should be clipped by all ancestor frames.
+ */
+export const getAncestorFrames = (
+  element: ExcalidrawElement,
+  elementsMap: ElementsMap,
+): ExcalidrawFrameLikeElement[] => {
+  const ancestors: ExcalidrawFrameLikeElement[] = [];
+  let current: ExcalidrawElement | null = element;
+
+  while (current?.frameId) {
+    const parent = elementsMap.get(current.frameId);
+    if (parent && isFrameLikeElement(parent)) {
+      ancestors.push(parent);
+      current = parent;
+    } else {
+      break;
+    }
+  }
+
+  return ancestors;
+};
+
+export const layoutFrameChildren = (
+  frame: ExcalidrawFrameLikeElement,
+  allElements: ElementsMapOrArray,
+  direction = frame.autoLayout,
+  opts: {
+    width?: number;
+    height?: number;
+    padding?: Partial<{ horizontal: number; vertical: number }>;
+    gap?: number;
+  } = {},
+): boolean => {
+  if (!direction) {
+    return false;
+  }
+
+  const padding = {
+    horizontal:
+      opts.padding?.horizontal ??
+      frame.autoLayoutPadding?.horizontal ??
+      DEFAULT_FRAME_AUTO_LAYOUT_PADDING,
+    vertical:
+      opts.padding?.vertical ??
+      frame.autoLayoutPadding?.vertical ??
+      DEFAULT_FRAME_AUTO_LAYOUT_PADDING,
+  };
+  const gap =
+    opts.gap ?? frame.autoLayoutGap ?? DEFAULT_FRAME_AUTO_LAYOUT_GAP;
+
+  const elementsMap = arrayToMap(allElements);
+  const elements = Array.isArray(allElements)
+    ? allElements
+    : Array.from(allElements.values());
+  const children = getFrameChildren(getNonDeletedElements(elements), frame.id)
+    .filter((element) => !(isTextElement(element) && element.containerId))
+    .sort((a, b) => {
+      if (direction === "vertical") {
+        return a.y === b.y ? a.x - b.x : a.y - b.y;
+      }
+      return a.x === b.x ? a.y - b.y : a.x - b.x;
+    });
+
+  if (!children.length) {
+    return false;
+  }
+
+  let cursorX = frame.x + padding.horizontal;
+  let cursorY = frame.y + padding.vertical;
+  let contentWidth = 0;
+  let contentHeight = 0;
+
+  for (const child of children) {
+    const [x1, y1, x2, y2] = getElementAbsoluteCoords(child, elementsMap);
+    const deltaX = cursorX - x1;
+    const deltaY = cursorY - y1;
+
+    mutateElement(child, elementsMap, {
+      x: child.x + deltaX,
+      y: child.y + deltaY,
+    });
+
+    const boundTextElement = getBoundTextElement(child, elementsMap);
+    if (boundTextElement) {
+      mutateElement(boundTextElement, elementsMap, {
+        x: boundTextElement.x + deltaX,
+        y: boundTextElement.y + deltaY,
+      });
+    }
+
+    const childWidth = x2 - x1;
+    const childHeight = y2 - y1;
+
+    if (direction === "vertical") {
+      cursorY += childHeight + gap;
+      contentHeight += childHeight + (contentHeight ? gap : 0);
+      contentWidth = Math.max(contentWidth, childWidth);
+    } else {
+      cursorX += childWidth + gap;
+      contentWidth += childWidth + (contentWidth ? gap : 0);
+      contentHeight = Math.max(contentHeight, childHeight);
+    }
+  }
+
+  const contentFrameWidth = contentWidth + padding.horizontal * 2;
+  const contentFrameHeight = contentHeight + padding.vertical * 2;
+
+  mutateElement(frame, elementsMap, {
+    width: Math.max(opts.width ?? frame.width, contentFrameWidth),
+    height: Math.max(opts.height ?? frame.height, contentFrameHeight),
+    autoLayoutPadding: padding,
+    autoLayoutGap: gap,
+  });
+
+  return true;
+};
