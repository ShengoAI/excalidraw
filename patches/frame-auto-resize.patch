+const isAutoLayoutMember = (element: ExcalidrawElement) =>
+  !(isTextElement(element) && element.containerId);
+
+const getAutoLayoutClusterKey = (
+  element: ExcalidrawElement,
+  editingGroupId: string | null,
+) => {
+  const { groupIds } = element;
+  if (editingGroupId) {
+    const editingIndex = groupIds.indexOf(editingGroupId);
+    if (editingIndex !== -1) {
+      return editingIndex > 0
+        ? `group:${groupIds[editingIndex - 1]}`
+        : `element:${element.id}`;
+    }
+  }
+  const outerGroupId = groupIds.at(-1);
+  return outerGroupId ? `group:${outerGroupId}` : `element:${element.id}`;
+};
+
+export const collectAutoLayoutItems = (
+  elements: readonly ExcalidrawElement[],
+  elementsMap: ElementsMap,
+  opts?: {
+    editingGroupId?: string | null;
+    excludeIds?: ReadonlySet<string>;
+  },
+): FrameAutoLayoutItem[] => {
+  const clusters = new Map<string, ExcalidrawElement[]>();
+  const order: string[] = [];
+
+  for (const element of elements) {
+    if (!isAutoLayoutMember(element) || element.isDeleted) {
+      continue;
+    }
+    if (opts?.excludeIds?.has(element.id)) {
+      continue;
+    }
+    const key = getAutoLayoutClusterKey(
+      element,
+      opts?.editingGroupId ?? null,
+    );
+    let cluster = clusters.get(key);
+    if (!cluster) {
+      cluster = [];
+      clusters.set(key, cluster);
+      order.push(key);
+    }
+    cluster.push(element);
+  }
+
+  return order.map((key) => {
+    const cluster = clusters.get(key)!;
+    const [x1, y1, x2, y2] = getCommonBounds(cluster, elementsMap);
+    return { elements: cluster, x1, y1, x2, y2 };
+  });
+};
+
+const sortAutoLayoutItems = (
+  items: FrameAutoLayoutItem[],
+  direction: "vertical" | "horizontal",
+) => {
+  items.sort((a, b) => {
+    if (direction === "vertical") {
+      return a.y1 === b.y1 ? a.x1 - b.x1 : a.y1 - b.y1;
+    }
+    return a.x1 === b.x1 ? a.y1 - b.y1 : a.x1 - b.x1;
+  });
+  return items;
+};
