+/**
+ * Renders the background fill for frames.
+ * This is called BEFORE rendering children so that children appear on top of the background.
+ * The frame outline/stroke is rendered separately via renderElement after children.
+ */
+const renderFrameBackgrounds = (
+  context: CanvasRenderingContext2D,
+  visibleElements: readonly NonDeletedExcalidrawElement[],
+  appState: StaticCanvasAppState,
+) => {
+  if (!appState.frameRendering.enabled) {
+    return;
+  }
+
+  // Render frame backgrounds in z-order (lowest first)
+  for (const element of visibleElements) {
+    if (!isFrameLikeElement(element)) {
+      continue;
+    }
+
+    // Only render background if not transparent
+    if (element.backgroundColor === "transparent") {
+      continue;
+    }
+
+    context.save();
+    context.translate(
+      element.x + appState.scrollX,
+      element.y + appState.scrollY,
+    );
+
+    // Apply element opacity
+    context.globalAlpha = element.opacity / 100;
+
+    // Apply background color
+    context.fillStyle = applyDarkModeFilter(
+      element.backgroundColor,
+      appState.theme === THEME.DARK,
+    );
+
+    // Draw the background with rounded corners
+    if (FRAME_STYLE.radius && context.roundRect) {
+      context.beginPath();
+      context.roundRect(
+        0,
+        0,
+        element.width,
+        element.height,
+        FRAME_STYLE.radius / appState.zoom.value,
+      );
+      context.fill();
+      context.closePath();
+    } else {
+      context.fillRect(0, 0, element.width, element.height);
+    }
+
+    context.restore();
+  }
+};
