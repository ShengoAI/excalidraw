+export const layoutFrameChildren = (
+  frame: ExcalidrawFrameLikeElement,
+  allElements: ElementsMapOrArray,
+  direction = frame.autoLayout,
+  opts: {
+    width?: number;
+    height?: number;
+    padding?: Partial<{ horizontal: number; vertical: number }>;
+    gap?: number;
+    hug?: FrameAutoLayoutHug;
+    align?: FrameAutoLayoutAlign;
+    editingGroupId?: string | null;
+  } = {},
