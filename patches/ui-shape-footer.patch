+  private renderShapeFooters() {
+    const renderShapeFooter = this.props.renderShapeFooter;
+    if (!renderShapeFooter) {
+      return null;
+    }
+
+    const scale = this.state.zoom.value;
+    const elementsMap = this.scene.getNonDeletedElementsMap();
+    return this.scene.getNonDeletedElements().map((element) => {
+      if (
+        !(
+          isFrameLikeElement(element) ||
+          element.type === "rectangle" ||
+          element.type === "diamond" ||
+          element.type === "ellipse"
+        )
+      ) {
+        return null;
+      }
+
+      if (
+        !isElementInViewport(
+          element,
+          this.canvas.width / window.devicePixelRatio,
+          this.canvas.height / window.devicePixelRatio,
+          {
+            offsetLeft: this.state.offsetLeft,
+            offsetTop: this.state.offsetTop,
+            scrollX: this.state.scrollX,
+            scrollY: this.state.scrollY,
+            zoom: this.state.zoom,
+          },
+          elementsMap,
+        )
+      ) {
+        return null;
+      }
+
+      const footer = renderShapeFooter(element, this.state);
+      if (footer == null || footer === false) {
+        return null;
+      }
+
+      const { x, y } = sceneCoordsToViewportCoords(
+        { sceneX: element.x, sceneY: element.y },
+        this.state,
+      );
+
+      return (
+        <div
+          key={`shape-footer-${element.id}`}
+          className={CLASSES.SHAPE_FOOTER}
+          style={{
+            position: "absolute",
+            transform: `translate(${x - this.state.offsetLeft}px, ${
+              y - this.state.offsetTop
+            }px) scale(${scale})`,
+            transformOrigin: "top left",
+            pointerEvents: POINTER_EVENTS.disabled,
+            zIndex: 2,
+          }}
+        >
+          <div
+            className={`${CLASSES.SHAPE_FOOTER}__inner`}
+            style={{
+              position: "relative",
+              width: element.width,
+              height: element.height,
+              transform: `rotate(${element.angle}rad)`,
+              overflow: "hidden",
+            }}
+          >
+            <div
+              className={`${CLASSES.SHAPE_FOOTER}__content`}
+              style={{
+                position: "absolute",
+                left: 0,
+                right: 0,
+                bottom: 0,
+                display: "flex",
+                justifyContent: "center",
+                padding: `${SHAPE_FOOTER_PADDING.top}px ${SHAPE_FOOTER_PADDING.horizontal}px ${SHAPE_FOOTER_PADDING.bottom}px`,
+                boxSizing: "border-box",
+              }}
+            >
+              {footer}
+            </div>
+          </div>
+        </div>
+      );
+    });
+  }
