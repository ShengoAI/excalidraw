+  private setShapeChromeSlotWidth = (
+    elementId: string,
+    slot: "topLeft" | "topRight",
+    width: number,
+  ) => {
+    const prev = this.shapeChromeSlotWidths.get(elementId) ?? {
+      topLeft: 0,
+      topRight: 0,
+    };
+    if (prev[slot] === width) {
+      return false;
+    }
+    this.shapeChromeSlotWidths.set(elementId, {
+      ...prev,
+      [slot]: width,
+    });
+    return true;
+  };
+
+  private syncFrameNameChromeOffset = (elementId: string) => {
