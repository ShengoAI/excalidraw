+  private getFrameNameViewportOrigin = (
+    frame: ExcalidrawFrameLikeElement,
+    topLeftWidth: number,
+    titleGap: number,
+  ) => {
+    const [titleSceneX, titleSceneY] = pointRotateRads(
+      pointFrom(
+        frame.x + FRAME_STYLE.nameInsetX + topLeftWidth + titleGap,
+        frame.y + FRAME_STYLE.nameInsetY,
+      ),
+      pointFrom(frame.x + frame.width / 2, frame.y + frame.height / 2),
+      frame.angle,
+    );
+    return sceneCoordsToViewportCoords(
