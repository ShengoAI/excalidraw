+  private getFrameNameChromeOffset = (frame: ExcalidrawFrameLikeElement) => {
+    const chromeSlots = this.shapeChromeSlotWidths.get(frame.id);
+    const topLeftWidth = chromeSlots?.topLeft ?? 0;
+    const topRightWidth = chromeSlots?.topRight ?? 0;
+    const titleGap = topLeftWidth > 0 ? SHAPE_TOP_TITLE_GAP : 0;
+    return { topLeftWidth, topRightWidth, titleGap };
+  };
