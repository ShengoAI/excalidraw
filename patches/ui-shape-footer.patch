+    const titleEl = document.getElementById(this.getFrameNameDOMId(element));
+    if (!(titleEl instanceof HTMLElement)) {
+      return;
+    }
+
+    const { topLeftWidth, topRightWidth, titleGap } =
+      this.getFrameNameChromeOffset(element);
+    const { x: x1, y: y1 } = this.getFrameNameViewportOrigin(
+      element,
+      topLeftWidth,
+      titleGap,
+    );
+
+    titleEl.style.top = `${y1 - this.state.offsetTop}px`;
+    titleEl.style.left = `${x1 - this.state.offsetLeft}px`;
+    titleEl.style.transform = `rotate(${element.angle}rad)`;
+    titleEl.style.transformOrigin = "top left";
+    titleEl.style.maxWidth = `${
