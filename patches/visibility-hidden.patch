+export const isElementHidden = <T extends ExcalidrawElement>(
+  element: T | null | undefined,
+  elementsMap?: ElementsMap,
+): boolean => {
+  if (!element) {
+    return false;
+  }
+  if (element.hidden) {
+    return true;
+  }
+  if (!elementsMap) {
+    return false;
+  }
+  if (isTextElement(element) && element.containerId) {
+    const container = elementsMap.get(element.containerId);
+    if (container?.hidden) {
+      return true;
+    }
+  }
+  let frameId = element.frameId;
+  const seen = new Set<string>();
+  while (frameId && !seen.has(frameId)) {
+    seen.add(frameId);
+    const frame = elementsMap.get(frameId);
+    if (!frame) {
+      break;
+    }
+    if (frame.hidden) {
+      return true;
+    }
+    frameId = frame.frameId;
+  }
+  return false;
+};
