+
+describe("frame interior hit testing", () => {
+  it("hits a frame when clicking empty interior", () => {
+    const frame = API.createElement({
+      type: "frame",
+      x: 0,
+      y: 0,
+      width: 200,
+      height: 200,
+    });
+    const elementsMap = arrayToMap([frame]);
+
+    expect(
+      hitElementItself({
+        point: pointFrom<GlobalPoint>(100, 100),
+        element: frame,
+        threshold: 10,
+        elementsMap,
+      }),
+    ).toBe(true);
+  });
+
+  it("does not hit a frame when clicking outside it", () => {
+    const frame = API.createElement({
+      type: "frame",
+      x: 0,
+      y: 0,
+      width: 200,
+      height: 200,
+    });
+    const elementsMap = arrayToMap([frame]);
+
+    expect(
+      hitElementItself({
+        point: pointFrom<GlobalPoint>(300, 300),
+        element: frame,
+        threshold: 10,
+        elementsMap,
+      }),
+    ).toBe(false);
+  });
+});
