+
+describe("selecting frames by interior click", () => {
+  beforeEach(async () => {
+    await render(<Excalidraw />);
+  });
+
+  it("selects a frame when clicking empty interior", () => {
+    const frame = API.createElement({
+      id: "frame",
+      type: "frame",
+      x: 0,
+      y: 0,
+      width: 200,
+      height: 200,
+    });
+
+    API.setElements([frame]);
+    mouse.clickAt(100, 100);
+
+    expect(h.state.selectedElementIds[frame.id]).toBe(true);
+  });
+
+  it("selects a child instead of the frame when clicking the child", () => {
+    const frame = API.createElement({
+      id: "frame",
+      type: "frame",
+      x: 0,
+      y: 0,
+      width: 200,
+      height: 200,
+    });
+    const child = API.createElement({
+      id: "child",
+      type: "rectangle",
+      x: 40,
+      y: 40,
+      width: 40,
+      height: 40,
+      backgroundColor: "#ffc9c9",
+      fillStyle: "solid",
+      frameId: frame.id,
+    });
+
+    API.setElements([frame, child]);
+    mouse.clickAt(60, 60);
+
+    expect(h.state.selectedElementIds[child.id]).toBe(true);
+    expect(h.state.selectedElementIds[frame.id]).toBeUndefined();
+  });
+});
