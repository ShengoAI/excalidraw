+  /** Title chrome sits inside the frame; clicks there select the frame. */
+  private getFrameAtNameLabel = (
+    x: number,
+    y: number,
+    includeLockedElements?: boolean,
+  ): NonDeleted<ExcalidrawFrameLikeElement> | null => {
+    const frames = this.scene.getNonDeletedFramesLikes();
+    for (let index = frames.length - 1; index >= 0; index--) {
+      const frame = frames[index];
+      if (frame.locked && !includeLockedElements) {
+        continue;
+      }
+      if (this.isPointInFrameNameLabel(frame, x, y)) {
+        return frame;
+      }
+    }
+    return null;
+  };
+
+  private isPointInFrameNameLabel = (
+    frame: ExcalidrawFrameLikeElement,
+    x: number,
+    y: number,
+  ) => {
+    const { topLeftWidth, topRightWidth, titleGap } =
+      this.getFrameNameChromeOffset(frame);
+    const width = Math.max(
+      0,
+      frame.width -
+        FRAME_STYLE.nameInsetX * 2 -
+        topLeftWidth -
+        titleGap -
+        topRightWidth,
+    );
+    const height = Math.max(
+      SHAPE_TOP_CONTENT_MIN_HEIGHT,
+      FRAME_STYLE.nameFontSize * FRAME_STYLE.nameLineHeight,
+    );
+    const localLeft = FRAME_STYLE.nameInsetX + topLeftWidth + titleGap;
+    const localTop = FRAME_STYLE.nameInsetY;
+    const center = pointFrom(
+      frame.x + frame.width / 2,
+      frame.y + frame.height / 2,
+    );
+    const [localX, localY] = pointRotateRads(
+      pointFrom(x, y),
+      center,
+      -frame.angle as Radians,
+    );
+    const px = localX - frame.x;
+    const py = localY - frame.y;
+    return (
+      px >= localLeft &&
+      py >= localTop &&
+      px <= localLeft + width &&
+      py <= localTop + height
+    );
+  };
+
