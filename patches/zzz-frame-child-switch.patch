+  /** Selected frames still hit-test on their interior, so a child click would
+   *  look like "clicked the current selection" and get ignored. */
+  private isClickingAlreadySelected(
+    hitElement: ExcalidrawElement | null,
+    allHitElements: readonly ExcalidrawElement[],
+  ) {
+    return allHitElements.some((element) => {
+      if (!this.isASelectedElement(element)) {
+        return false;
+      }
+      if (
+        isFrameLikeElement(element) &&
+        hitElement &&
+        hitElement.id !== element.id
+      ) {
+        return false;
+      }
+      return true;
+    });
+  }
