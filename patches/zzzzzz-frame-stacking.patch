+/** True when `element` is the frame or nested inside it. */
+export const isElementDescendantOfFrame = (
+  element: ExcalidrawElement,
+  frameId: string,
+  elementsMap: ElementsMap,
+) => {
+  let current: ExcalidrawElement | undefined = element;
+  while (current) {
+    if (current.id === frameId) {
+      return true;
+    }
+    if (!current.frameId) {
+      return false;
+    }
+    current = elementsMap.get(current.frameId);
+  }
+  return false;
+};
+
+/**
+ * Pick the topmost hit while treating a frame and its descendants as one
+ * stacking group. A later frame covers earlier frames and their children;
+ * children of the covering frame stay selectable above that frame's fill.
+ */
+export const pickHitWithFrameStacking = <T extends ExcalidrawElement>(
+  hits: readonly T[],
+  elementsMap: ElementsMap,
+): T | null => {
+  if (hits.length === 0) {
+    return null;
+  }
+
+  const pick = (candidates: readonly T[]): T => {
+    const top = candidates[candidates.length - 1];
+    if (!isFrameLikeElement(top)) {
+      return top;
+    }
+    const nested = candidates.filter(
+      (element) =>
+        element.id !== top.id &&
+        isElementDescendantOfFrame(element, top.id, elementsMap),
+    );
+    if (nested.length > 0) {
+      return pick(nested);
+    }
+    return top;
+  };
+
+  return pick(hits);
+};
