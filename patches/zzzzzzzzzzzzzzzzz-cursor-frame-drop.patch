+/**
+ * Records the cursor-approved frame target for the active drag selection.
+ *
+ * Consumers may reconcile frame membership after Excalidraw's pointer-up
+ * callback. Keeping this decision outside React state prevents those consumers
+ * from adding an element by geometry when its cursor never entered the frame.
+ */
+export const setCursorFrameDropTargets = (
+  elements: readonly ExcalidrawElement[],
