+export const isConnectorCrossingFrameBoundary = (
+  element: ExcalidrawElement,
+  frameId: ExcalidrawFrameLikeElement["id"],
+  elementsMap: ElementsMap,
+) => {
+  if (
+    !isLinearElement(element) ||
+    !isElementDescendantOfFrame(element, frameId, elementsMap)
+  ) {
+    return false;
+  }
+
+  return [element.startBinding, element.endBinding].some((binding) => {
+    if (!binding) {
+      return false;
+    }
+    const boundElement = elementsMap.get(binding.elementId);
+    return (
+      !boundElement ||
+      !isElementDescendantOfFrame(boundElement, frameId, elementsMap)
+    );
+  });
+};
+
+/** Frame children whose geometry should participate in resize-to-fit. */
+export const getFrameChildrenForBounds = (
+  allElements: ElementsMapOrArray,
+  frameId: ExcalidrawFrameLikeElement["id"],
+) => {
+  const elementsMap = arrayToMap(allElements);
+  return getFrameChildren(allElements, frameId).filter(
+    (element) =>
+      !isConnectorCrossingFrameBoundary(element, frameId, elementsMap),
+  );
+};
