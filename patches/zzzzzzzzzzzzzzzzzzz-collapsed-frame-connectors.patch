+const COLLAPSED_FRAME_BINDINGS_KEY = "shengoCollapsedFrameBindings";
+
+/**
+ * While a frame is collapsed, route connectors from hidden descendants to
+ * the collapsed frame edge. Restores the original descendant binding when
+ * expanding so the relationship remains unchanged.
+ */
+export const updateCollapsedFrameConnectorBindings = (
+  frame: NonDeleted<ExcalidrawFrameLikeElement>,
+  collapsed: boolean,
+  scene: Scene,
+) => {
+  const elementsMap = scene.getNonDeletedElementsMap();
+  const targetsToUpdate = new Map<
+    ExcalidrawElement["id"],
+    NonDeleted<ExcalidrawBindableElement>
+  >();
+
+  for (const element of scene.getNonDeletedElements()) {
+    if (!isArrowElement(element)) {
+      continue;
+    }
+
+    const stored = (element.customData?.[COLLAPSED_FRAME_BINDINGS_KEY] ?? {}) as
+      Record<
+        string,
+        Partial<
+          Record<"start" | "end", NonNullable<typeof element.startBinding>>
+        >
+      >;
+    const frameStored = stored[frame.id] ?? {};
+    let didChange = false;
+
+    for (const end of ["start", "end"] as const) {
+      const field = end === "start" ? "startBinding" : "endBinding";
+      const binding = element[field];
+
+      if (collapsed) {
+        const bindingTarget = binding
+          ? elementsMap.get(binding.elementId)
+          : null;
+        if (
+          !binding ||
+          binding.elementId === frame.id ||
+          !bindingTarget ||
+          !isElementDescendantOfFrame(bindingTarget, frame.id, elementsMap)
+        ) {
+          continue;
+        }
+
+        const oppositeBinding =
+          element[end === "start" ? "endBinding" : "startBinding"];
+        const opposite = oppositeBinding
+          ? elementsMap.get(oppositeBinding.elementId)
+          : null;
+        if (
+          !oppositeBinding ||
+          !opposite ||
+          isElementDescendantOfFrame(opposite, frame.id, elementsMap)
+        ) {
+          continue;
+        }
+
+        const dx = opposite.x + opposite.width / 2 - (frame.x + frame.width / 2);
+        const dy = opposite.y + opposite.height / 2 - (frame.y + frame.height / 2);
+        const scale =
+          0.5 /
+          Math.max(
+            Math.abs(dx) / Math.max(frame.width, 1),
+            Math.abs(dy) / Math.max(frame.height, 1),
+          );
+        const fixedPoint = pointFrom(
+          0.5 + (dx * scale) / Math.max(frame.width, 1),
+          0.5 + (dy * scale) / Math.max(frame.height, 1),
+        );
+
+        unbindBindingElement(element, end, scene);
+        bindBindingElementToFixedPoint(element, frame, end, fixedPoint, scene);
+        frameStored[end] = binding;
+        targetsToUpdate.set(frame.id, frame);
+        didChange = true;
+      } else {
+        const originalBinding = frameStored[end];
+        if (!originalBinding || binding?.elementId !== frame.id) {
+          continue;
+        }
+        const originalTarget = elementsMap.get(originalBinding.elementId);
+        if (!originalTarget || !isBindableElement(originalTarget)) {
+          continue;
+        }
+        unbindBindingElement(element, end, scene);
+        bindBindingElementToFixedPoint(
+          element,
+          originalTarget as NonDeleted<ExcalidrawBindableElement>,
+          end,
+          originalBinding.fixedPoint,
+          scene,
+        );
+        delete frameStored[end];
+        targetsToUpdate.set(originalTarget.id, originalTarget);
+        didChange = true;
+      }
+    }
+
+    if (!didChange) {
+      continue;
+    }
+
+    const nextStored = { ...stored };
+    if (frameStored.start || frameStored.end) {
+      nextStored[frame.id] = frameStored;
+    } else {
+      delete nextStored[frame.id];
+    }
+    scene.mutateElement(element, {
+      customData: {
+        ...element.customData,
+        [COLLAPSED_FRAME_BINDINGS_KEY]: nextStored,
+      },
+    });
+  }
+
+  targetsToUpdate.forEach((target) => updateBoundElements(target, scene));
+};
