+/** Side of the collapsed frame the user attached the endpoint to. */
+const fixedPointForCollapsedFrameEndpoint = (
+  endpoint: readonly [number, number],
+  rect: { x: number; y: number; width: number; height: number },
+) => {
+  const width = Math.max(rect.width, 1);
+  const height = Math.max(rect.height, 1);
+  const relX = Math.min(1, Math.max(0, (endpoint[0] - rect.x) / width));
+  const relY = Math.min(1, Math.max(0, (endpoint[1] - rect.y) / height));
+  const distLeft = Math.abs(endpoint[0] - rect.x);
+  const distRight = Math.abs(endpoint[0] - (rect.x + rect.width));
+  const distTop = Math.abs(endpoint[1] - rect.y);
+  const distBottom = Math.abs(endpoint[1] - (rect.y + rect.height));
+  const min = Math.min(distLeft, distRight, distTop, distBottom);
+  if (min === distTop) {
+    return pointFrom(relX, 0);
+  }
+  if (min === distBottom) {
+    return pointFrom(relX, 1);
+  }
+  if (min === distLeft) {
+    return pointFrom(0, relY);
+  }
+  return pointFrom(1, relY);
+};
