+  /** A nested frame that hugs its children must also resize every parent frame. */
+  private relayoutAncestorFrames = (frameId: string) => {
+    if (this.isRelayoutingAncestorFrames) {
+      return;
+    }
+    this.isRelayoutingAncestorFrames = true;
+    try {
+      const seen = new Set<string>([frameId]);
+      let currentId: string | null = frameId;
+      while (currentId) {
+        const current = this.scene.getNonDeletedElementsMap().get(currentId);
+        const parentId =
+          current && typeof current.frameId === "string" ? current.frameId : null;
+        if (!parentId || seen.has(parentId)) {
+          break;
+        }
+        seen.add(parentId);
+        const parent = this.scene.getNonDeletedElementsMap().get(parentId);
+        if (!parent || !isFrameLikeElement(parent) || parent.collapsed) {
+          break;
+        }
+        if (!parent.autoLayout) {
+          currentId = parentId;
+          continue;
+        }
+        this.updateFrameLayout(parentId, {});
+        currentId = parentId;
+      }
+    } finally {
+      this.isRelayoutingAncestorFrames = false;
+    }
+  };
+
+  private isRelayoutingAncestorFrames = false;
