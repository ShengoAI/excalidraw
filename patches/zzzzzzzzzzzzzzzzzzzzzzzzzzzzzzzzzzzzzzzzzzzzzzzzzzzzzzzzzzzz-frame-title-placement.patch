+/** Title placement is stored in customData so it survives scene restore. */
+export const getFrameNameVerticalAlign = (frame: ExcalidrawFrameLikeElement) =>
+  !frame.collapsed &&
+  (frame.customData?.shengoFrameTitleVerticalAlign === "middle" ||
+    frame.customData?.shengoFrameTitleVerticalAlign === "bottom")
+    ? frame.customData.shengoFrameTitleVerticalAlign
+    : "top";
+
+export const getFrameNameHeight = (
+  frame: ExcalidrawFrameLikeElement,
+  width = frame.width - FRAME_STYLE.nameInsetX * 2,
+) => {
+  const font = getFontString({
+    fontSize: getFrameNameFontSize(frame),
+    fontFamily: getFrameNameFontFamily(frame),
+    customData: frame.customData,
+  });
+  const text = wrapText(getFrameLikeTitle(frame), font, Math.max(1, width))
+    .split("\n")
+    .slice(0, FRAME_TITLE_MAX_LINES)
+    .join("\n");
+  return Math.max(
+    SHAPE_TOP_CONTENT_MIN_HEIGHT,
+    measureText(
+      text,
+      font,
+      FRAME_STYLE.nameLineHeight as ExcalidrawTextElement["lineHeight"],
+    ).height,
+  );
+};
+
+/** Plain containers only need bottom padding; entity containers have a footer. */
+export const getFrameNameBottomInset = (
+  frame: ExcalidrawFrameLikeElement & { entityId?: unknown },
+) =>
+  typeof frame.entityId === "string" && frame.entityId.length > 0
+    ? SHAPE_FOOTER_RESERVED_HEIGHT
+    : SHAPE_FOOTER_PADDING.bottom;
+
+export const getFrameNameOffsetY = (
+  frame: ExcalidrawFrameLikeElement,
+  titleHeight = getFrameNameHeight(frame),
+) => {
+  const align = getFrameNameVerticalAlign(frame);
+  const bottom = frame.height - getFrameNameBottomInset(frame) - titleHeight;
+  return align === "top"
+    ? FRAME_STYLE.nameInsetY
+    : Math.max(
+        FRAME_STYLE.nameInsetY,
+        align === "bottom"
+          ? bottom
+          : Math.min(bottom, (frame.height - titleHeight) / 2),
+      );
+};
 
