diff --git a/packages/element/tests/frameTitlePlacement.test.ts b/packages/element/tests/frameTitlePlacement.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/element/tests/frameTitlePlacement.test.ts
@@ -0,0 +1,100 @@
+import {
+  FRAME_STYLE,
+  SHAPE_FOOTER_PADDING,
+  SHAPE_FOOTER_RESERVED_HEIGHT,
+} from "@excalidraw/common";
+import { API } from "@excalidraw/excalidraw/tests/helpers/api";
+import {
+  getAutoLayoutDropIndicator,
+  getFrameNameHeight,
+  getFrameNameOffsetY,
+  layoutFrameChildren,
+} from "../src/frame";
+
+describe("container title placement", () => {
+  const frame = (placement = "top", overrides = {}) => ({
+    ...API.createElement({ type: "frame", width: 300, height: 300 }),
+    entityId: "entity-1",
+    customData: { shengoFrameTitleVerticalAlign: placement },
+    ...overrides,
+  });
+  it("defaults to the top inset", () => {
+    expect(getFrameNameOffsetY(frame())).toBe(FRAME_STYLE.nameInsetY);
+  });
+  it("centers an empty title block", () => {
+    const f = frame("middle");
+    expect(getFrameNameOffsetY(f)).toBe((f.height - getFrameNameHeight(f)) / 2);
+  });
+  it("keeps bottom titles above the entity footer", () => {
+    const f = frame("bottom");
+    expect(getFrameNameOffsetY(f) + getFrameNameHeight(f)).toBe(
+      f.height - SHAPE_FOOTER_RESERVED_HEIGHT,
+    );
+  });
+  it.each([undefined, null, ""])(
+    "uses bottom padding without an entity link (%s)",
+    (entityId) => {
+      const f = frame("bottom", { entityId });
+      expect(getFrameNameOffsetY(f) + getFrameNameHeight(f)).toBe(
+        f.height - SHAPE_FOOTER_PADDING.bottom,
+      );
+    },
+  );
+  it("adjusts title placement when the entity link is added or removed", () => {
+    const plain = frame("bottom", { entityId: undefined });
+    const entity = { ...plain, entityId: "entity-1" };
+    const removed = { ...entity, entityId: undefined };
+    const footerSpace =
+      SHAPE_FOOTER_RESERVED_HEIGHT - SHAPE_FOOTER_PADDING.bottom;
+    expect(getFrameNameOffsetY(plain) - getFrameNameOffsetY(entity)).toBe(
+      footerSpace,
+    );
+    expect(getFrameNameOffsetY(removed)).toBe(getFrameNameOffsetY(plain));
+  });
+  it("uses the recovered footer space for auto-layout drop indicators", () => {
+    const entity = { ...frame("bottom"), autoLayout: "horizontal" as const };
+    const plain = { ...entity, entityId: undefined };
+    const pointer = { x: 0, y: 0 };
+    const entityIndicator = getAutoLayoutDropIndicator(entity, [], pointer)!;
+    const plainIndicator = getAutoLayoutDropIndicator(plain, [], pointer)!;
+    expect(plainIndicator.y2 - entityIndicator.y2).toBe(
+      SHAPE_FOOTER_RESERVED_HEIGHT - SHAPE_FOOTER_PADDING.bottom,
+    );
+  });
+  it("fits auto-layout children without reserving a missing entity footer", () => {
+    const fit = (entityId: string | undefined) => {
+      const f = {
+        ...frame("bottom"),
+        entityId,
+        autoLayout: "vertical" as const,
+        autoLayoutHug: { horizontal: false, vertical: true },
+      };
+      const child = API.createElement({
+        type: "rectangle",
+        width: 80,
+        height: 40,
+        frameId: f.id,
+      });
+      layoutFrameChildren(f, [f, child]);
+      expect(child.y + child.height).toBeLessThanOrEqual(
+        f.y + getFrameNameOffsetY(f),
+      );
+      return f.height;
+    };
+    expect(fit("entity-1") - fit(undefined)).toBe(
+      SHAPE_FOOTER_RESERVED_HEIGHT - SHAPE_FOOTER_PADDING.bottom,
+    );
+  });
+  it("accounts for wrapped large titles", () => {
+    const f = frame("bottom", {
+      name: "First line\nSecond line",
+      fontSize: 32,
+    });
+    expect(getFrameNameHeight(f)).toBe(80);
+    expect(getFrameNameOffsetY(f)).toBe(176);
+  });
+  it("keeps collapsed and short containers at the top inset", () => {
+    expect(getFrameNameOffsetY(frame("middle", { collapsed: true }))).toBe(12);
+    expect(getFrameNameOffsetY(frame("bottom", { height: 48 }))).toBe(12);
+  });
+});
